APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=reaccess_hub
DATABASE_USER=reaccess_app
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_SSL=false

JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SKIP_DATABASE_CONNECTION=false

# Optional OpenAI Responses API integration; never pass these to Flutter.
# Choose a model that supports structured JSON output.
AI_API_KEY=
AI_MODEL=

# Gmail SMTP: use an App Password, never your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
LETTER_TEMPLATE_PATH=
LETTER_TEMPLATE_URL=
REPORT_FONT_PATH=

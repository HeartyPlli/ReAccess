# Frontend build-time configuration. This file is safe to commit because all
# values are placeholders and contain no secrets.
API_BASE_URL=http://localhost:8080/api/v1

# Backend runtime configuration.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# PostgreSQL is used by the Dart backend only. Do not expose these values to
# Flutter Web and do not use the PostgreSQL superuser as the application user.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=reaccess_hub
DATABASE_USER=reaccess_app
DATABASE_PASSWORD=SoftwareEngineering
POSTGRES_ADMIN_PASSWORD=SoftwareEngineering
DATABASE_SSL=false

# Use a long random secret in real environments.
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Local development only. Set false when a database is available.
SKIP_DATABASE_CONNECTION=false

# Optional AI support, backend only. Leave blank for FAQ-only mode.
AI_API_KEY=
AI_MODEL=

# Backend-only Gmail SMTP and Twilio credentials.
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
LETTER_TEMPLATE_PATH=/app/templates/formal-letter.docx
LETTER_TEMPLATE_URL=
